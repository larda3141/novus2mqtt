# novus2mqtt configuration template.
# Copy to `.env` and fill in your values, then `chmod 600 .env`.
# Defaults shown match src/main.rs.

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=human            # human | json
# LOG_FILE=/var/log/novus2mqtt.log
ENABLE_FILE_LOGGING=false

# === MQTT broker ===
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=change_me
MQTT_BASE_PREFIX=novus2mqtt
MQTT_TLS=false
MQTT_TLS_INSECURE=false
MQTT_CLEAR_ON_START=false

# === RS485 serial ===
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600

# === Config files ===
NOVUS_CONFIG=./config/device.yaml
# NOVUS_REGISTERS=./config/registers.yaml   # only if non-default

# === Home Assistant ===
HASS_DISCOVERY=true
HASS_DISCOVERY_PREFIX=homeassistant
HASS_DEVICE_DISCOVERY=false                 # one bundled payload vs per-entity
HASS_DISCOVERY_MODE=startup                 # startup | lazy

# === Behavior ===
AUTO_SYNC_TIME=false
REQ_MEM_ON_STARTUP=false                    # true = burst memory dump at boot (disrupts TFT briefly)
HIGHLIGHT_UNKNOWN_REGS=true
ACTIVITY_LOG=false

# === Throttling ===
THROTTLE_MAX_INTERVAL=0                     # global heartbeat (seconds), 0 = off
THROTTLE_MIN_CHANGE_PCT=0                   # global min relative change (%), 0 = off
DISABLE_THROTTLE=false

# === Diagnostics ===
SUMMARY_INTERVAL=10                         # seconds, 0 = off
# BUS_DUMP_FILE=/var/log/novus2mqtt/bus.log # raw frame dump for protocol analysis
MAX_MEMORY_MB=0                             # memory guard, 0 = off
